# Etapa 1: Construcción del proyecto Angular
FROM node:20 AS build

WORKDIR /usr/src/app

# Copiar dependencias
COPY app/package*.json ./
RUN npm install

# Copiar el resto del proyecto Angular
COPY app/ .

# Compilar en modo producción
RUN npm run build -- --configuration production

# Etapa 2: Servir con Caddy
FROM caddy:2-alpine

# Copiar el resultado correcto (Angular 17+: dist/app/browser/)
COPY --from=build /usr/src/app/dist/app/browser/ /usr/share/caddy/

# 👇 Copiar TU Caddyfile al lugar que Caddy usa por defecto
COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80
