@startuml
title Diagrama de Secuencia: Ver usuarios aprobados eliminados

actor Administrador
participant UI as "pages - usuarios"
participant FE_Service as "services - usersService"
participant BE as "Backend API"
participant DB as "Base de Datos"

Administrador -> UI : Abre modal "Usuarios eliminados"

UI -> FE_Service : getDeletedUsers()

FE_Service -> BE : GET /users/deleted_user

BE -> DB : Consultar usuarios\nestado = 'aprobado' AND eliminado = true
DB --> BE : Lista de usuarios aprobados eliminados

alt Lista vacía
    BE --> UI : 200 OK\n[]
    UI --> Administrador : Mostrar mensaje\n"No hay usuarios aprobados eliminados"
else Lista con resultados
    BE --> UI : 200 OK\n[usuarios aprobados eliminados]
    UI --> Administrador : Mostrar tabla\n"Usuarios aprobados eliminados"
end

@enduml
